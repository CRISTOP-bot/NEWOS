#!/usr/bin/env bash
# newos-package: wrap a built SDK ELF in a native .new package.
#
#   newos-package build/myapp.elf --name myapp --version 1.0.0
#   newos-package build/myapp.elf --name myapp --dest /bin/mytool -o myapp.new
#
# The generated package is a normal .new archive: inspect it with
# `newpkg info` on the host builder or on NEWOS, then install it on the
# target with `newpkg install /tmp/<file>.new`.
set -euo pipefail

SELF=$(readlink -f "$0")
SDK_DIR=$(dirname "$(dirname "$SELF")")
ROOT=$(dirname "$SDK_DIR")
BUILDER="$ROOT/tools/newpkg/newpkg-build.py"

elf=""
name=""
version="1.0.0"
dest=""
desc="NEWOS SDK application"
out=""
license="MIT"

usage() {
    echo "usage: newos-package <elf> --name NAME [--version V] [--dest /bin/NAME]"
    echo "                       [--desc TEXT] [--license L] [--out FILE.new]"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --name)    name=$2; shift 2 ;;
        --version) version=$2; shift 2 ;;
        --dest)    dest=$2; shift 2 ;;
        --desc)    desc=$2; shift 2 ;;
        --license) license=$2; shift 2 ;;
        --out|-o)  out=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "newos-package: unknown option $1" >&2; usage >&2; exit 1 ;;
        *) [ -z "$elf" ] || { echo "newos-package: too many inputs" >&2; exit 1; }; elf=$1; shift ;;
    esac
done

[ -n "$elf" ] && [ -n "$name" ] || { usage >&2; exit 1; }
[ -f "$elf" ] || { echo "newos-package: no such file: $elf" >&2; exit 1; }
[ -f "$BUILDER" ] || { echo "newos-package: missing $BUILDER" >&2; exit 1; }

dest=${dest:-"/bin/$name"}
out=${out:-"$name-$version-x86_64.new"}
mkdir -p "$(dirname "$out")"

spec=$(mktemp)
trap 'rm -f "$spec"' EXIT
cat > "$spec" <<EOF
# generated by newos-package - do not edit
name = "$name"
version = "$version"
arch = "x86_64"
desc = "$desc"
license = "$license"
maintainer = "NEWOS SDK"
build = "newos-cc + newos-package"
newos-min = "0.2.0"
depends = ""

files:
  $(readlink -f "$elf") $dest 0755
EOF

python3 "$BUILDER" "$spec" -o "$out" --root /
echo "newos-package: $out ($(stat -c %s "$out") bytes) -> $dest"
