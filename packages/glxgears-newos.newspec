# Built by the superproject with the host compiler and NEWOS libc; the same
# binary is embedded in the normal image as /bin/glxgears.
name = "glxgears-newos"
version = "0.1.0"
arch = "x86_64"
desc = "TinyGL software-rendered gears demo for the NEWOS framebuffer"
license = "MIT"
maintainer = "NEWOS"
build = "make glxgears-newos"
newos-min = "0.3.0"
depends = ""

# Preserve TinyGL's required copyright and permission notice with the binary.
files:
  build/userland/glxgears.elf /bin/glxgears 0755
  ports/glxgears-newos/vendor/tinygl/LICENSE /usr/share/licenses/glxgears-newos/TinyGL-LICENSE 0644
